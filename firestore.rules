rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTripMember(data) {
      return signedIn() && request.auth.uid in data.memberIds;
    }

    match /trips/{tripId} {
      // 查詢必須搭配 memberIds array-contains 目前使用者。
      allow get, list: if isTripMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isTripMember(resource.data)
        || (signedIn()
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members']));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /inviteCodes/{inviteCode} {
      // 只允許用邀請碼查單筆文件，不允許列出所有邀請碼。
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.tripId is string;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
